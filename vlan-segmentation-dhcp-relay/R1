! =========================================
! Router Configuration
! Projeto DHCP Relay e VLAN Segmentation
! =========================================

hostname R1


! =========================================
! VLAN 10 - RH
! =========================================

interface GigabitEthernet00.10
 encapsulation dot1Q 10
 ip address 192.168.10.1 255.255.255.0
 ip helper-address 192.168.99.10
 description VLAN 10 - RH

! =========================================
! VLAN 20 - TI
! =========================================

interface GigabitEthernet00.20
 encapsulation dot1Q 20
 ip address 192.168.20.1 255.255.255.0
 ip helper-address 192.168.99.10
 description VLAN 20 - TI

! =========================================
! VLAN 30 - GUEST
! =========================================

interface GigabitEthernet00.30
 encapsulation dot1Q 30
 ip address 192.168.30.1 255.255.255.0
 ip helper-address 192.168.99.10
 description VLAN 30 - GUEST

! =========================================
! VLAN 40 - FINANCE
! =========================================

interface GigabitEthernet00.40
 encapsulation dot1Q 40
 ip address 192.168.40.1 255.255.255.0
 ip helper-address 192.168.99.10
 description VLAN 40 - FINANCE

! =========================================
! VLAN 99 - MANAGEMENT
! =========================================

interface GigabitEthernet00.99
 encapsulation dot1Q 99
 ip address 192.168.99.1 255.255.255.0
 description VLAN 99 - MANAGEMENT

! =========================================
! Interfaces Nao Utilizadas
! =========================================

interface GigabitEthernet01
 shutdown

interface GigabitEthernet02
 shutdown


! =========================================
! Fim da Configuracao
! =========================================
